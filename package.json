{
	"name": "emr-appointments",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages"
	],
	"description": "",
	"main": "index.js",
	"scripts": {
		"dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
		"dev:api": "npm run dev -w apps/server",
		"dev:web": "npm run dev -w apps/client",
		"build": "npm run build -w apps/server && npm run build -w apps/client",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "npm run typecheck -w apps/server && npm run typecheck -w apps/client",
		"seed": "npm run seed -w apps/server",
		"add:department": "npm run add:department -w apps/server --",
		"migrate:departments": "npm run migrate:departments -w apps/server",
		"test": "npm run test -w packages && npm run test -w apps/server && npm run test -w apps/client",
		"test:e2e": "playwright test"
	},
	"keywords": [],
	"type": "commonjs",
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.64.1",
		"concurrently": "^10.0.6",
		"typescript": "^7.0.2"
	}
}
